{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Plumo",
  "version": "0.1.0",
  "identifier": "com.aimerite.plumo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5202",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Plumo",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 28
        },
        "backgroundColor": "#fafafa",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost data:",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "object-src": "'self' asset: http://asset.localhost",
        "frame-src": "'self' asset: http://asset.localhost data:"
      },
      "devCsp": "default-src 'self' ipc: http://ipc.localhost http://localhost:5202 http://127.0.0.1:5202; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' 'unsafe-eval' http://localhost:5202 http://127.0.0.1:5202; connect-src 'self' ipc: http://ipc.localhost data: http://localhost:5202 http://127.0.0.1:5202 ws://localhost:5202 ws://127.0.0.1:5202; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; font-src 'self' data:; media-src 'self' asset: http://asset.localhost data: blob:; object-src 'self' asset: http://asset.localhost; frame-src 'self' asset: http://asset.localhost data:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Default",
        "contentTypes": ["net.daringfireball.markdown"]
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {}
}
